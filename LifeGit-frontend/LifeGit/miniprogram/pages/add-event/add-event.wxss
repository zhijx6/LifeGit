/* ============ 说明文字 ============ */
/* 辅助文字 13px/400 */
.tips {
  padding: 48rpx 32rpx 0;
  text-align: center;
}

.tips-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 38rpx;
  font-weight: 400;
}
