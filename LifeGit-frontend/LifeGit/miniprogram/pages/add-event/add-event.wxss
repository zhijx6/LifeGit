/**pages/add-event/add-event.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 event-form 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  background: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1A1A1A;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 32rpx 64rpx;
}

/* ============ 页面头部 ============ */
/* 页面标题 24px/600，副标题 14px/400 灰 */
.page-header {
  padding: 56rpx 8rpx 48rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.page-subtitle {
  font-size: 28rpx;
  color: #777777;
  font-weight: 400;
  display: block;
  margin-top: 8rpx;
  line-height: 1.45;
}

/* ============ 事件类型列表 ============ */
/* 单张白卡分组 + 发丝分割线，Apple 设置页风格 */
.event-types {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECECEC;
  overflow: hidden;
}

.event-card {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  transition: background-color 0.2s ease;
}

.event-card:last-child {
  border-bottom: none;
}

.event-card:active {
  background: #F7F7F7;
}

/* 图标：浅灰底小方块 + 黑灰线性 SVG */
.card-icon-svg {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background-color: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: -0.3rpx;
  line-height: 1.4;
}

.card-arrow {
  font-size: 44rpx;
  color: #B5B5B5;
  font-weight: 300;
  margin-left: 16rpx;
  flex-shrink: 0;
  line-height: 1;
  transition: color 0.2s ease;
}

.event-card:active .card-arrow {
  color: #1A1A1A;
}

/* ---- 各事件类型的线性图标（黑灰描边，与 event-form 一致） ---- */
