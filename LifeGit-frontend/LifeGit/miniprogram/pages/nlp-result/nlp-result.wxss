/**pages/nlp-result/nlp-result.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 add-event / event-form 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  background: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1A1A1A;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 底部预留空间，防固定操作条遮挡 */
.container {
  padding: 0 32rpx 240rpx;
}

/* ============ 成功提示 ============ */
/* 白卡 + 浅灰 ✓ 图标块，无彩色横幅 */
.success-banner {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 0;
  box-sizing: border-box;
}

.success-icon {
  display: inline-block;
  width: 64rpx;
  height: 64rpx;
  line-height: 62rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 400;
  color: #1A1A1A;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  box-sizing: border-box;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.success-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.success-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.success-desc {
  font-size: 26rpx;
  color: #999999;
  font-weight: 400;
}

/* ============ 原始文本 ============ */
.original-text-section {
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.section-label {
  font-size: 26rpx;
  color: #999999;
  font-weight: 400;
  display: block;
  margin-bottom: 12rpx;
}

.original-text {
  font-size: 28rpx;
  color: #777777;
  font-weight: 400;
  line-height: 44rpx;
  display: block;
}

/* ============ 实体识别结果 ============ */
.entities-section {
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: -0.3rpx;
}

/* 卡内嵌套块：#F7F7F7 底 + #E5E5E5 边框 + 发丝分割线 */
.entities-list {
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  overflow: hidden;
}

.entity-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.entity-item:last-child {
  border-bottom: none;
}

/* 层级：标签 26rpx #999999 + 值 30rpx #1A1A1A */
.entity-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.entity-label {
  font-size: 26rpx;
  color: #999999;
  font-weight: 400;
  margin-bottom: 4rpx;
  display: block;
}

.entity-value {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  display: block;
}

.entity-confidence {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.confidence-text {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

/* ============ 分类建议 ============ */
.category-section {
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.category-recommendation {
  margin-bottom: 32rpx;
}

/* 推荐分类：选中态样式（白底 + 黑边） */
.category-main {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #1A1A1A;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.category-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.category-desc {
  font-size: 26rpx;
  color: #999999;
  font-weight: 400;
}

/* 推荐徽标：黑色小药丸 */
.category-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  background: #1A1A1A;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
  line-height: 30rpx;
}

.subsection-title {
  font-size: 26rpx;
  font-weight: 400;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

.category-alternatives {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 其他分类：嵌套块，选中态白底黑边 */
.category-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.category-item.active {
  border-color: #1A1A1A;
  background: #FFFFFF;
}

.category-item:active {
  background: #F0F0F0;
}

.category-item.active:active {
  background: #F7F7F7;
}

.category-radio {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.radio-icon {
  font-size: 32rpx;
  color: #B5B5B5;
  line-height: 1;
}

.category-item.active .radio-icon {
  color: #1A1A1A;
}

.alt-category-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.alt-category-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 4rpx;
  display: block;
}

.category-item.active .alt-category-name {
  font-weight: 600;
}

.alt-category-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

/* ============ 结构化信息预览 ============ */
.structured-info-section {
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.info-preview {
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  overflow: hidden;
}

.preview-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.preview-item:last-child {
  border-bottom: none;
}

.preview-label {
  font-size: 26rpx;
  color: #999999;
  font-weight: 400;
  margin-right: 24rpx;
  min-width: 96rpx;
  flex-shrink: 0;
}

.preview-value {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  min-width: 0;
  word-break: break-all;
}

/* ============ 底部操作条 ============ */
/* 白底 + 上边框 + 安全区适配 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E5E5E5;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.secondary-btn {
  background: #FFFFFF;
  color: #1A1A1A;
  border: 1rpx solid #E5E5E5;
  box-sizing: border-box;
}

.secondary-btn:active {
  background: #F7F7F7;
}

.primary-btn {
  background: #1A1A1A;
  color: #FFFFFF;
}

.primary-btn:active {
  background: #333333;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 500;
}
