/**pages/nlp-result/nlp-result.wxss**/
page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #f0f2f8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 30rpx 40rpx;
}

/* 成功提示 */
.success-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 30rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(67, 233, 123, 0.3);
}

.success-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.success-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.success-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.success-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 原始文本 */
.original-text-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.section-label {
  font-size: 24rpx;
  color: #8e9aaf;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.original-text {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  line-height: 42rpx;
}

/* 实体识别结果 */
.entities-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: -0.3rpx;
}

.entities-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.entity-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.entity-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.entity-icon-wrapper.brand {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
}

.entity-icon-wrapper.color {
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.15) 0%, rgba(245, 87, 108, 0.15) 100%);
}

.entity-icon-wrapper.type {
  background: linear-gradient(135deg, rgba(79, 172, 254, 0.15) 0%, rgba(0, 242, 254, 0.15) 100%);
}

.entity-icon-wrapper.organization {
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.15) 0%, rgba(253, 160, 133, 0.15) 100%);
}

.entity-icon {
  font-size: 28rpx;
}

.entity-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entity-label {
  font-size: 22rpx;
  color: #8e9aaf;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.entity-value {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
}

.entity-confidence {
  flex-shrink: 0;
}

.confidence-text {
  font-size: 20rpx;
  color: #43e97b;
  background: linear-gradient(135deg, rgba(67, 233, 123, 0.1) 0%, rgba(56, 249, 215, 0.1) 100%);
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

/* 分类建议 */
.category-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.category-recommendation {
  margin-bottom: 28rpx;
}

.category-main {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-radius: 16rpx;
  border: 2rpx solid #667eea;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.category-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.category-icon {
  font-size: 32rpx;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.category-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.category-desc {
  font-size: 24rpx;
  color: #8e9aaf;
  font-weight: 400;
}

.category-badge {
  position: absolute;
  top: -8rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(67, 233, 123, 0.3);
}

.badge-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 700;
}

.subsection-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6c757d;
  display: block;
  margin-bottom: 16rpx;
}

.category-alternatives {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.category-item.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-color: #667eea;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.category-radio {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.radio-icon {
  font-size: 32rpx;
  color: #adb5bd;
}

.category-item.active .radio-icon {
  color: #667eea;
}

.alt-category-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.alt-category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.alt-category-desc {
  font-size: 22rpx;
  color: #8e9aaf;
}

/* 结构化信息预览 */
.structured-info-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.info-preview {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  border-radius: 12rpx;
}

.preview-label {
  font-size: 24rpx;
  color: #8e9aaf;
  font-weight: 600;
  margin-right: 16rpx;
  min-width: 80rpx;
}

.preview-value {
  flex: 1;
  font-size: 26rpx;
  color: #2c3e50;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  transition: all 0.3s;
}

.secondary-btn {
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  color: #6c757d;
  border: 2rpx solid #e8ecf1;
}

.primary-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.action-btn:active {
  transform: scale(0.96);
}
