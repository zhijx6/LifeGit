/**login.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 add-event / event-form 同一套体系） */

page {
  background: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1A1A1A;
}

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

/* ============ 品牌区 ============ */
.login-header {
  text-align: center;
  margin-bottom: 64rpx;
}

.login-title {
  display: block;
  font-size: 64rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: -2rpx;
  line-height: 1.2;
}

.login-subtitle {
  display: block;
  font-size: 28rpx;
  color: #777777;
  font-weight: 400;
  margin-top: 16rpx;
}

/* ============ 表单卡片 ============ */
/* 白底 + 极浅边框 + 12px 圆角，无阴影 */
.login-form {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

/* 模块标题 20px/600 */
.form-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: -0.5rpx;
  margin-bottom: 48rpx;
}

/* 字段组间距 24px */
.input-group {
  margin-bottom: 48rpx;
}

/* ============ 输入框 ============ */
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 400;
  box-sizing: border-box;
  background: #FFFFFF;
  color: #1A1A1A;
  transition: border-color 0.2s ease;
}

.input:focus {
  border-color: #1A1A1A;
}

/* ============ 主按钮 ============ */
/* 黑底白字，44px 高 / 10px 圆角，无阴影 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 20rpx;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  background: #333333;
}

.submit-btn[disabled] {
  background: #1A1A1A;
  color: #FFFFFF;
  opacity: 0.4;
}

/* ============ 切换登录/注册 ============ */
.toggle-mode {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #777777;
  padding: 8rpx 0;
  transition: color 0.2s ease;
}

.toggle-mode:active {
  color: #1A1A1A;
}
