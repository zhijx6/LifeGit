.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: #000;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.login-title {
  display: block;
  font-size: 64rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
}

.login-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 16rpx;
}

.login-form {
  width: 100%;
  max-width: 600rpx;
  background: #111;
  border: 2rpx solid #333;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 48rpx;
  color: #fff;
}

.input-group {
  margin-bottom: 32rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #333;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #000;
  color: #fff;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #000;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
  margin-top: 16rpx;
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.4;
}

.toggle-mode {
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #888;
}
