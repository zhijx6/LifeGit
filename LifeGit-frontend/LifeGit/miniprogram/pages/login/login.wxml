<view class="login-page">
  <view class="login-header">
    <text class="login-title">LifeGit</text>
    <text class="login-subtitle">物品生命周期管理</text>
  </view>

  <view class="login-form">
    <view class="form-title">{{isLogin ? '登录' : '注册'}}</view>

    <view class="input-group">
      <input class="input" placeholder="手机号/邮箱" value="{{account}}" bindinput="onAccountInput" />
    </view>

    <view class="input-group" wx:if="{{!isLogin}}">
      <input class="input" placeholder="昵称（可选）" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>

    <view class="input-group">
      <input class="input" placeholder="密码（至少6位）" password value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <button class="submit-btn" bindtap="submit" disabled="{{loading}}" loading="{{loading}}">
      {{isLogin ? '登录' : '注册'}}
    </button>

    <view class="toggle-mode" bindtap="toggleMode">
      <text>{{isLogin ? '没有账号？去注册' : '已有账号？去登录'}}</text>
    </view>
  </view>
</view>
