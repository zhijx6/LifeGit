/**pages/my/my.wxss**/
page {
  height: 100vh;
  background: linear-gradient(180deg, #f5f5f5 0%, #e8e8e8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  min-height: 100vh;
  padding: 0 30rpx;
  box-sizing: border-box;
}

/* 页面头部 */
.page-header {
  padding: 50rpx 0 40rpx;
}

.page-title {
  font-size: 52rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -1rpx;
}

/* 仓库列表 */
.repo-list {
  margin-top: 30rpx;
}

.repo-item {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.repo-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.03) 0%, rgba(0, 0, 0, 0.02) 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.repo-item:active {
  transform: scale(0.97);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
}

.repo-item:active::before {
  opacity: 1;
}

.repo-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 1;
}

.repo-info {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.repo-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: -0.3rpx;
}

.repo-brand-brand {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.repo-spec {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 14rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 500;
}

.repo-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.event-count {
  font-size: 22rpx;
  color: #333333;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.06) 0%, rgba(0, 0, 0, 0.04) 100%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.create-time {
  font-size: 22rpx;
  color: #999999;
  font-weight: 500;
}

.repo-arrow {
  margin-left: 20rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.arrow-icon {
  font-size: 40rpx;
  color: #d1d5db;
  font-weight: 200;
  transition: all 0.3s;
}

.repo-item:active .arrow-icon {
  transform: translateX(6rpx);
  color: #2c2c2c;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 40rpx;
  display: block;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 60rpx;
  font-weight: 500;
}

.go-create-btn {
  width: 260rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.go-create-btn:active {
  transform: scale(0.96);
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 28rpx;
  font-weight: 500;
}

/* 设置区域 */
.settings-section {
  margin-top: 60rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: background 0.2s;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item:active {
  background: #f5f5f5;
}

.settings-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.settings-label {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.settings-arrow {
  font-size: 36rpx;
  color: #d1d5db;
  font-weight: 200;
}

/* 用户信息区 */
.user-section {
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-avatar-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
}

.user-detail {
  flex: 1;
}

.user-nickname {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 4rpx;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.user-actions {
  display: flex;
  gap: 16rpx;
}

.user-action-btn {
  padding: 12rpx 28rpx;
  border: 2rpx solid #333;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.user-action-btn:active {
  background: #1a1a1a;
}

.action-label {
  font-size: 24rpx;
  color: #333;
  font-weight: 600;
}

.user-action-btn:active .action-label {
  color: #fff;
}

/* 编辑昵称弹窗 */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
}

.modal-body {
  padding: 32rpx;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm-btn {
  background: #1a1a1a;
  color: #fff;
}
