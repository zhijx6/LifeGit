page {
  height: 100vh;
  background: #000;
}
.scrollarea { flex: 1; overflow-y: hidden; }
.container { padding: 30rpx; }

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.unread-count {
  font-size: 26rpx;
  color: #888;
}
.read-all-btn {
  font-size: 26rpx;
  color: #fff;
  background: #333;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
}
.read-all-btn:active { background: #555; }

.mention-item {
  display: flex;
  align-items: center;
  background: #111;
  border: 2rpx solid #333;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  position: relative;
  transition: all 0.2s;
}
.mention-item.unread { border-color: #666; background: #1a1a1a; }
.mention-item:active { transform: scale(0.98); }

.mention-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.mention-content { flex: 1; min-width: 0; }
.mention-issue-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mention-reply-text {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mention-meta { display: flex; gap: 16rpx; }
.mention-time { font-size: 22rpx; color: #666; }

.mention-arrow {
  font-size: 36rpx;
  color: #555;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}
.empty-icon { font-size: 100rpx; opacity: 0.3; margin-bottom: 30rpx; display: block; }
.empty-text { font-size: 30rpx; color: #666; }

.loading-state {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  color: #666;
  font-size: 26rpx;
}
