/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #e8e8e8 0%, #f5f5f5 30%, #f0f0f0 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 0 40rpx;
  position: relative;
}

/* 顶部Banner */
.banner-wrapper {
  position: relative;
  width: 100%;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: auto;
  display: block;
}

/* 顶部用户信息 */
.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  padding: 80rpx 30rpx 30rpx;
  z-index: 10;
}

.login-btn {
  background: #1a1a1a;
  color: white;
  border-radius: 24rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  line-height: normal;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.login-btn::after {
  border: none;
}

.header-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

/* 创建区域 */
.create-section {
  margin: 0 30rpx 50rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 28rpx;
  letter-spacing: -0.5rpx;
}

/* 创建卡片容器 - 横向排列 */
.create-cards-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.create-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 24rpx;
  padding: 36rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  flex: 1;
  height: 240rpx;
}

.create-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.03) 0%, rgba(0, 0, 0, 0.02) 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.create-card:active {
  transform: scale(0.97);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  background: linear-gradient(135deg, #f8f8f8 0%, #f0f0f0 100%);
}

.create-card:active::before {
  opacity: 1;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 1;
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}

.icon-text {
  font-size: 48rpx;
  color: white;
  font-weight: 300;
}

.manual-card .card-icon {
  background: linear-gradient(135deg, #4d4d4d 0%, #333333 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.nlp-card .card-icon {
  background: linear-gradient(135deg, #666666 0%, #4d4d4d 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
}

.nlp-icon::before {
  display: none;
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  text-align: center;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  letter-spacing: -0.3rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
  line-height: 1.4;
}

.nlp-examples {
  margin-top: 6rpx;
}

.example-text {
  font-size: 18rpx;
  color: #333333;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.04) 0%, rgba(0, 0, 0, 0.02) 100%);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-style: italic;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  display: none;
}

.card-arrow {
  display: none;
}

.create-card:active .card-arrow {
  display: none;
}

/* 手动创建弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 0;
  animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 30rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  letter-spacing: -0.5rpx;
}

.modal-close {
  width: 44rpx;
  height: 44rpx;
  padding: 8rpx;
  font-size: 36rpx;
  color: #adb5bd;
  line-height: 44rpx;
  text-align: center;
  display: block;
  transition: transform 0.3s;
}

.modal-close:active {
  color: #666666;
  transform: rotate(90deg);
}

.modal-body {
  padding: 40rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 18rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  box-sizing: border-box;
  transition: transform 0.3s;
  color: #1a1a1a;
}

.form-input:focus {
  border-color: #333333;
  background-color: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(0, 0, 0, 0.05);
}

.modal-footer {
  display: flex;
  padding: 30rpx 40rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  transition: transform 0.3s;
}

.cancel-btn {
  background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
  color: #666666;
  border: 2rpx solid #cccccc;
}

.confirm-btn {
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.modal-btn:active {
  transform: scale(0.96);
}

/* 类型选择器 */
.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border: 2rpx solid #333;
  border-radius: 16rpx;
  background: #fafafa;
  transition: all 0.2s;
}

.type-option.active {
  background: #1a1a1a;
  border-color: #1a1a1a;
}

.type-option .type-icon {
  font-size: 36rpx;
}

.type-option .type-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.type-option.active .type-text {
  color: #fff;
}

/* 图片上传 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.delete-image {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 12rpx;
}

.add-image-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #999;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-image-btn .add-icon {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.add-image-btn .add-text {
  font-size: 20rpx;
  color: #999;
}
