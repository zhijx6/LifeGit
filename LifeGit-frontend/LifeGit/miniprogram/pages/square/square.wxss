/**pages/square/square.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 my / repo-detail 同一套体系） */

page {
  height: 100vh;
  background: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1A1A1A;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* ============ 搜索栏 ============ */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.search-icon {
  font-size: 32rpx;
  color: #999999;
  margin-right: 16rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  min-width: 0;
}

.search-ph {
  color: #B5B5B5;
}

.search-clear {
  font-size: 28rpx;
  color: #B5B5B5;
  padding: 8rpx 8rpx 8rpx 16rpx;
  line-height: 1;
}

.search-btn {
  padding: 20rpx 32rpx;
  background: #1A1A1A;
  border-radius: 24rpx;
  box-sizing: border-box;
  transition: opacity 0.2s ease;
}

.search-btn:active {
  opacity: 0.8;
}

.search-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* ============ 仓库列表（与 my 页同一套卡片样式） ============ */
.repo-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  transition: background-color 0.2s ease;
}

.repo-item:active {
  background: #F7F7F7;
}

.repo-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: #F0F0F0;
  flex-shrink: 0;
}

.repo-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.repo-thumb-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #B5B5B5;
  line-height: 1;
}

.repo-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.repo-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: -0.3rpx;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.repo-brand-brand {
  font-size: 26rpx;
  color: #777777;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.repo-spec {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.repo-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.owner-name {
  font-size: 24rpx;
  color: #1A1A1A;
  white-space: nowrap;
}

.event-count {
  font-size: 24rpx;
  color: #777777;
}

.create-time {
  font-size: 24rpx;
  color: #999999;
}

.repo-arrow {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 44rpx;
  color: #B5B5B5;
  font-weight: 300;
  line-height: 1;
}

.repo-item:active .arrow-icon {
  color: #1A1A1A;
}

/* ============ 空状态 / 加载 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #777777;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #999999;
}

.no-more {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
  font-size: 24rpx;
  color: #B5B5B5;
}
