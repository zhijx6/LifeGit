/**pages/issue-list/issue-list.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 add-event / event-form 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  background: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1A1A1A;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 32rpx 160rpx;
  position: relative;
}

/* ============ 头部统计 ============ */
/* 白卡 + 极浅边框，无阴影；数字统一黑色，不使用彩色语义 */
.header-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECECEC;
  padding: 32rpx 20rpx;
  margin: 24rpx 0 24rpx;
  box-sizing: border-box;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #F0F0F0;
}

/* ============ 筛选标签 ============ */
/* 与 event-form 单选组同一交互语言：灰底 → 选中白底黑边 */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-tab {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.filter-tab.active {
  background: #FFFFFF;
  border-color: #1A1A1A;
}

.filter-tab:active {
  background: #F7F7F7;
}

.tab-text {
  font-size: 26rpx;
  font-weight: 400;
  color: #777777;
}

.filter-tab.active .tab-text {
  color: #1A1A1A;
  font-weight: 600;
}

/* ============ 问题列表 ============ */
.issues-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.issue-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECECEC;
  padding: 32rpx;
  box-sizing: border-box;
  transition: background-color 0.2s ease;
}

.issue-card:active {
  background: #F7F7F7;
}

.issue-status {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 状态点三档灰：待解答 #1A1A1A / 已解答 #777777 / 已关闭 #E5E5E5 */
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #E5E5E5;
  flex-shrink: 0;
}

.status-dot.open {
  background: #1A1A1A;
}

.status-dot.answered {
  background: #777777;
}

.status-text {
  font-size: 24rpx;
  color: #777777;
  font-weight: 400;
}

.issue-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  display: block;
  line-height: 46rpx;
  letter-spacing: -0.3rpx;
}

.issue-preview {
  font-size: 26rpx;
  color: #777777;
  line-height: 40rpx;
  display: -webkit-box;
  margin-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.issue-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.user-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F0F0F0;
  flex-shrink: 0;
}

.author-name {
  font-size: 24rpx;
  color: #777777;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dot-separator {
  font-size: 20rpx;
  color: #B5B5B5;
  flex-shrink: 0;
}

.create-time {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}

.meta-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.answer-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.answer-count {
  font-size: 24rpx;
  color: #777777;
  font-weight: 500;
}

/* 最佳答案标记：白底 + 浅灰边框 + 黑色 ✓ */
.best-answer-badge {
  width: 32rpx;
  height: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.best-answer-text {
  font-size: 20rpx;
  color: #1A1A1A;
  font-weight: 600;
  line-height: 1;
}

/* ============ 空状态 ============ */
/* 纯文字：主文案 28rpx #777777 + 副文案 26rpx #999999 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #777777;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 48rpx;
}

.ask-first-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.ask-first-btn:active {
  background: #333333;
}

/* ============ 悬浮提问按钮 ============ */
.floating-ask-btn {
  position: fixed;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  right: 32rpx;
  width: 96rpx;
  height: 96rpx;
  background: #1A1A1A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: background-color 0.2s ease;
}

.floating-ask-btn:active {
  background: #333333;
}

.floating-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}
