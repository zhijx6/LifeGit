/**pages/issue-list/issue-list.wxss**/
page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #f0f2f8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 30rpx 40rpx;
  position: relative;
}

/* 头部统计 */
.header-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  margin: 30rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 800;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.stat-number.answered {
  color: #43e97b;
}

.stat-number.open {
  color: #f5576c;
}

.stat-label {
  font-size: 24rpx;
  color: #8e9aaf;
  font-weight: 500;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(180deg, #e8ecf1 0%, #f0f2f8 100%);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #e8ecf1;
  transition: all 0.3s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.tab-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #6c757d;
}

.filter-tab.active .tab-text {
  color: #ffffff;
}

/* Issue列表 */
.issues-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 100rpx;
}

.issue-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  transition: all 0.3s;
}

.issue-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.issue-status {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.open {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  box-shadow: 0 2rpx 8rpx rgba(67, 233, 123, 0.4);
}

.status-dot.answered {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  box-shadow: 0 2rpx 8rpx rgba(79, 172, 254, 0.4);
}

.status-text {
  font-size: 22rpx;
  color: #8e9aaf;
  font-weight: 600;
}

.issue-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 12rpx;
  display: block;
  line-height: 46rpx;
}

.issue-preview {
  font-size: 26rpx;
  color: #6c757d;
  line-height: 40rpx;
  display: block;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.issue-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.user-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.author-name {
  font-size: 24rpx;
  color: #6c757d;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dot-separator {
  font-size: 20rpx;
  color: #adb5bd;
  flex-shrink: 0;
}

.create-time {
  font-size: 24rpx;
  color: #adb5bd;
  flex-shrink: 0;
}

.meta-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.answer-info {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.answer-icon {
  font-size: 20rpx;
}

.answer-count {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 600;
}

.best-answer-badge {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(67, 233, 123, 0.3);
}

.best-answer-text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 700;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8e9aaf;
  margin-bottom: 40rpx;
}

.ask-first-btn {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.ask-first-btn:active {
  transform: scale(0.95);
}

/* 悬浮提问按钮 */
.floating-ask-btn {
  position: fixed;
  bottom: 80rpx;
  right: 30rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
  z-index: 100;
  transition: all 0.3s;
}

.floating-ask-btn:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
}

.floating-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 200;
  line-height: 96rpx;
}
