/**pages/ask-question/ask-question.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 event-form 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  background: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1A1A1A;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 32rpx 64rpx;
}

/* ============ 提示信息 ============ */
/* 卡外提示块：#F7F7F7 底 + 灰点，无 emoji */
.tips-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 32rpx 0 24rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.tip-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #999999;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #777777;
  line-height: 38rpx;
}

/* ============ 表单卡片 ============ */
/* 表单卡：48rpx 40rpx 内边距，白底 + 极浅边框，无阴影 */
.form-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECECEC;
  padding: 48rpx 40rpx 52rpx;
  box-sizing: border-box;
}

.form-group {
  margin-bottom: 48rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: -0.3rpx;
}

.form-label.required::before {
  content: '* ';
  color: #777777;
  font-weight: 400;
}

.form-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin: -8rpx 0 20rpx;
  line-height: 38rpx;
}

/* ============ 输入框 ============ */
/* 统一 88rpx 高 / 20rpx 圆角 / 1rpx 灰边，focus 只变黑边 */
.title-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background-color: #FFFFFF;
  box-sizing: border-box;
  color: #1A1A1A;
  font-weight: 400;
  transition: border-color 0.2s ease;
}

.title-input:focus {
  border-color: #1A1A1A;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  background-color: #FFFFFF;
  box-sizing: border-box;
  line-height: 48rpx;
  color: #1A1A1A;
  transition: border-color 0.2s ease;
}

.content-input:focus {
  border-color: #1A1A1A;
}

.ph {
  color: #AAAAAA;
}

.char-count {
  font-size: 26rpx;
  color: #999999;
  text-align: right;
  display: block;
  margin-top: 12rpx;
  font-weight: 400;
}

/* ============ 相关记录 ============ */
/* 卡内嵌套块：#F7F7F7 底 + #E5E5E5 边框 + 20rpx 圆角 */
.related-commits {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.commit-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.commit-info {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.commit-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.commit-type {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.commit-desc {
  font-size: 26rpx;
  color: #777777;
  line-height: 38rpx;
}

.remove-commit {
  font-size: 36rpx;
  color: #B5B5B5;
  margin-left: 16rpx;
  flex-shrink: 0;
  line-height: 1;
  padding: 8rpx;
  transition: color 0.2s ease;
}

.remove-commit:active {
  color: #1A1A1A;
}

/* 添加按钮：白底虚线框 */
.add-commit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 2rpx dashed #D9D9DE;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.add-commit-btn:active {
  border-color: #999999;
  background: #F7F7F7;
}

.add-icon {
  font-size: 32rpx;
  color: #1A1A1A;
  margin-right: 8rpx;
  font-weight: 400;
  line-height: 1;
}

.add-text {
  font-size: 26rpx;
  color: #777777;
  font-weight: 500;
}

/* ============ 标签输入 ============ */
.tags-input {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 10rpx 16rpx;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
}

.tag-text {
  font-size: 26rpx;
  color: #1A1A1A;
  margin-right: 8rpx;
}

.tag-remove {
  font-size: 30rpx;
  color: #B5B5B5;
  line-height: 1;
  padding: 0 4rpx;
  transition: color 0.2s ease;
}

.tag-remove:active {
  color: #1A1A1A;
}

.tag-input-field {
  flex: 1;
  min-width: 200rpx;
  height: 64rpx;
  border: none;
  background: transparent;
  font-size: 26rpx;
  color: #1A1A1A;
}

/* ============ 匿名选项 ============ */
.anonymous-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-right: 24rpx;
}

.option-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.option-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 开关：灰轨 → 黑轨 */
.switch-wrapper {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #E5E5E5;
  position: relative;
  transition: background-color 0.2s ease;
  flex-shrink: 0;
}

.switch-wrapper.active {
  background: #1A1A1A;
}

.switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFFFF;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.2s ease;
}

.switch-wrapper.active .switch-dot {
  transform: translateX(40rpx);
}

/* ============ 提交按钮 ============ */
/* 可用：黑底白字；不可用：浅灰底浅灰字 */
.submit-section {
  margin-top: 48rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #F0F0F0;
  color: #AAAAAA;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.submit-btn.active {
  background: #1A1A1A;
  color: #FFFFFF;
}

.submit-btn.active:active {
  background: #333333;
}

.btn-text {
  color: inherit;
}

/* ============ 记录选择弹窗 ============ */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.modal-close {
  font-size: 36rpx;
  color: #B5B5B5;
  line-height: 1;
  padding: 8rpx;
  transition: color 0.2s ease;
}

.modal-close:active {
  color: #1A1A1A;
}

.modal-body {
  max-height: 600rpx;
  overflow-y: auto;
}

.commit-selector-list {
  display: flex;
  flex-direction: column;
}

.selector-commit-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
  transition: background-color 0.2s ease;
}

.selector-commit-item:last-child {
  border-bottom: none;
}

.selector-commit-item.active {
  background: #F7F7F7;
}

.selector-commit-item:active {
  background: #F7F7F7;
}

.selector-commit-info {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.selector-commit-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.commit-time {
  font-size: 22rpx;
  color: #999999;
}

/* 勾选框：黑底白 ✓ */
.checkbox-wrapper {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  box-sizing: border-box;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.checkbox-wrapper.checked {
  background: #1A1A1A;
  border-color: #1A1A1A;
}

.checkbox-icon {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

.modal-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.confirm-btn:active {
  background: #333333;
}
