<!--pages/ask-question/ask-question.wxml-->
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 提示信息 -->
    <view class="tips-section">
      <view class="tip-item">
        <text class="tip-icon">💡</text>
        <text class="tip-text">提问前请先搜索，避免重复提问</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">🎯</text>
        <text class="tip-text">清晰描述问题，更容易得到回答</text>
      </view>
    </view>

    <!-- 问题表单 -->
    <view class="form-section">
      <view class="form-group">
        <text class="form-label required">问题标题</text>
        <input
          class="title-input"
          placeholder="简要描述你的问题..."
          value="{{questionTitle}}"
          bindinput="onTitleInput"
          maxlength="50"
        />
        <text class="char-count">{{questionTitle.length}}/50</text>
      </view>

      <view class="form-group">
        <text class="form-label required">问题详情</text>
        <textarea
          class="content-input"
          placeholder="详细描述你的问题，包括具体场景、使用环境等..."
          value="{{questionContent}}"
          bindinput="onContentInput"
          maxlength="500"
          auto-height
          cursor-spacing="20"
        ></textarea>
        <text class="char-count">{{questionContent.length}}/500</text>
      </view>

      <!-- 相关Commit选择 -->
      <view class="form-group">
        <text class="form-label">关联记录（可选）</text>
        <text class="form-hint">选择相关的记录，帮助回答者更好理解你的问题</text>

        <view class="related-commits" wx:if="{{relatedCommits.length > 0}}">
          <view class="commit-item" wx:for="{{relatedCommits}}" wx:key="id">
            <view class="commit-info">
              <view class="commit-icon-wrapper {{item.type}}">
                <text class="commit-icon">{{item.icon}}</text>
              </view>
              <view class="commit-details">
                <text class="commit-type">{{item.type}}</text>
                <text class="commit-desc">{{item.description}}</text>
              </view>
            </view>
            <text class="remove-commit" bindtap="removeCommit" data-id="{{item.id}}">×</text>
          </view>
        </view>

        <view class="add-commit-btn" bindtap="showCommitSelector">
          <text class="add-icon">+</text>
          <text class="add-text">添加相关记录</text>
        </view>
      </view>

      <!-- 问题标签 -->
      <view class="form-group">
        <text class="form-label">问题标签（可选）</text>
        <view class="tags-input">
          <view class="tag-item" wx:for="{{tags}}" wx:key="*this">
            <text class="tag-text">{{item}}</text>
            <text class="tag-remove" bindtap="removeTag" data-tag="{{item}}">×</text>
          </view>
          <input
            class="tag-input-field"
            placeholder="添加标签..."
          value="{{tagInput}}"
          bindinput="onTagInput"
          bindconfirm="addTag"
          wx:if="{{tags.length < 5}}"
          />
        </view>
      </view>

      <!-- 匿名选项 -->
      <view class="form-group">
        <view class="anonymous-option">
          <view class="option-content">
            <text class="option-title">匿名提问</text>
            <text class="option-desc">开启后将隐藏你的个人信息</text>
          </view>
          <view class="switch-wrapper {{isAnonymous ? 'active' : ''}}" bindtap="toggleAnonymous">
            <view class="switch-dot"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button class="submit-btn {{canSubmit ? 'active' : ''}}" bindtap="submitQuestion" disabled="{{!canSubmit}}">
        <text class="btn-text">发起提问</text>
      </button>
    </view>
  </view>
</scroll-view>

<!-- Commit选择器弹窗 -->
<view class="modal-overlay" wx:if="{{showCommitSelector}}" bindtap="hideCommitSelector">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择相关记录</text>
      <text class="modal-close" bindtap="hideCommitSelector">✕</text>
    </view>
    <view class="modal-body">
      <view class="commit-selector-list">
        <view class="selector-commit-item {{isCommitSelected(item.id) ? 'active' : ''}}"
              wx:for="{{availableCommits}}"
              wx:key="id"
              bindtap="toggleCommit"
              data-id="{{item.id}}">
          <view class="selector-commit-info">
            <view class="commit-icon-wrapper {{item.type}}">
              <text class="commit-icon">{{item.icon}}</text>
            </view>
            <view class="selector-commit-details">
              <text class="commit-type">{{item.type}}</text>
              <text class="commit-desc">{{item.description}}</text>
              <text class="commit-time">{{item.time}}</text>
            </view>
          </view>
          <view class="checkbox-wrapper {{isCommitSelected(item.id) ? 'checked' : ''}}">
            <text class="checkbox-icon">{{isCommitSelected(item.id) ? '✓' : ''}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-btn confirm-btn" bindtap="confirmCommitSelection">确定</button>
    </view>
  </view>
</view>
