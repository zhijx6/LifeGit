/**pages/nlp-input/nlp-input.wxss**/
page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #f0f2f8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 30rpx;
  position: relative;
}

/* 头部装饰 */
.header-decoration {
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 400rpx;
  height: 400rpx;
  pointer-events: none;
  z-index: 0;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}

.circle-1 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  top: 0;
  right: 0;
  animation: float 6s ease-in-out infinite;
}

.circle-2 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  top: 100rpx;
  right: 50rpx;
  animation: float 4s ease-in-out infinite reverse;
}

.circle-3 {
  width: 150rpx;
  height: 150rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  top: 50rpx;
  right: 100rpx;
  animation: float 5s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20rpx) scale(1.05);
  }
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 60rpx 0 40rpx;
  position: relative;
  z-index: 1;
}

.page-title {
  font-size: 56rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: -1rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #8e9aaf;
  font-weight: 500;
}

/* 输入区域 */
.input-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.input-wrapper {
  position: relative;
  margin-bottom: 16rpx;
}

.nlp-input {
  width: 100%;
  min-height: 200rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  background-color: #fafbfc;
  box-sizing: border-box;
  line-height: 46rpx;
  transition: all 0.3s;
  color: #2c3e50;
}

.nlp-input:focus {
  border-color: #667eea;
  background-color: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.clear-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s;
  pointer-events: none;
}

.clear-btn.show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.clear-icon {
  font-size: 40rpx;
  color: white;
  line-height: 48rpx;
  font-weight: 200;
}

.char-count {
  text-align: right;
}

.count-text {
  font-size: 22rpx;
  color: #adb5bd;
  font-weight: 500;
}

/* 示例区域 */
.examples-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.examples-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: -0.3rpx;
}

.examples-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.example-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.example-item.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-color: #667eea;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.example-item:active {
  transform: scale(0.98);
}

.example-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.example-text {
  flex: 1;
  font-size: 26rpx;
  color: #2c3e50;
  font-weight: 500;
}

/* 功能说明 */
.features-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

.feature-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #8e9aaf;
  font-weight: 400;
}

/* 分析按钮 */
.analyze-btn-wrapper {
  padding: 20rpx 0 40rpx;
  position: relative;
  z-index: 1;
}

.analyze-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #e8ecf1 0%, #d1d5db 100%);
  border-radius: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s;
  opacity: 0.6;
}

.analyze-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  opacity: 1;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
}

.analyze-btn.active:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}
