/**pages/event-form/event-form.wxss**/
page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #f0f2f8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 30rpx 140rpx;
}

/* 事件头部 */
.event-header {
  display: flex;
  align-items: center;
  padding: 50rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 0 -30rpx 40rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
  position: relative;
  overflow: hidden;
}

.event-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.event-icon {
  font-size: 72rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
  position: relative;
  z-index: 1;
}

.header-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.event-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
  letter-spacing: -0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.event-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}

/* 不同事件类型的头部渐变 */
.event-header-purchase {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.event-header-maintenance {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.event-header-upgrade {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.event-header-experience {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.event-header-memory {
  background: linear-gradient(135deg, #eb2f96 0%, #f759ab 100%);
}

.event-header-fault {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.event-header-transfer {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

/* 地点型事件头部渐变 */
.event-header-visit {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
}

.event-header-review {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
}

.event-header-info_change {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
}

.event-header-wishlist {
  background: linear-gradient(135deg, #722ed1 0%, #9254de 100%);
}

/* 表单容器 */
.form-container {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.form-group {
  margin-bottom: 48rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  display: block;
  margin-bottom: 18rpx;
  letter-spacing: -0.3rpx;
}

.form-label.required::before {
  content: '*';
  color: #667eea;
  margin-right: 4rpx;
}

/* 表单输入 */
.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  background-color: #fafbfc;
  box-sizing: border-box;
  transition: all 0.3s;
  color: #2c3e50;
}

.form-input:focus {
  border-color: #667eea;
  background-color: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

/* 选择器 */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  padding: 0 28rpx;
  background-color: #fafbfc;
  box-sizing: border-box;
  transition: all 0.3s;
}

.form-picker:active {
  background-color: #ffffff;
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.picker-value {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.picker-value.placeholder {
  color: #adb5bd;
  font-weight: 400;
}

.picker-arrow {
  font-size: 36rpx;
  color: #d1d5db;
  font-weight: 200;
}

/* 价格输入 */
.price-input-wrapper {
  display: flex;
  align-items: center;
  height: 88rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  padding: 0 28rpx;
  background-color: #fafbfc;
  box-sizing: border-box;
  transition: all 0.3s;
}

.price-input-wrapper:focus-within {
  border-color: #667eea;
  background-color: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.currency-symbol {
  font-size: 36rpx;
  color: #2c3e50;
  margin-right: 12rpx;
  font-weight: 600;
}

.price-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  border: none;
  background: transparent;
  font-weight: 500;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 180rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  background-color: #fafbfc;
  box-sizing: border-box;
  line-height: 42rpx;
  transition: all 0.3s;
  color: #2c3e50;
}

.form-textarea:focus {
  border-color: #667eea;
  background-color: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.char-count {
  font-size: 22rpx;
  color: #adb5bd;
  text-align: right;
  display: block;
  margin-top: 10rpx;
  font-weight: 500;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  gap: 16rpx;
}

.radio-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  background-color: #fafbfc;
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.radio-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.radio-item.active {
  border-color: #667eea;
  background-color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.radio-item.active::before {
  opacity: 1;
}

.radio-icon {
  font-size: 28rpx;
  color: #adb5bd;
  margin-right: 8rpx;
  position: relative;
  z-index: 1;
}

.radio-item.active .radio-icon {
  color: #667eea;
}

.radio-label {
  font-size: 26rpx;
  color: #6c757d;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.radio-item.active .radio-label {
  color: #667eea;
  font-weight: 600;
}

/* 星级评分 */
.star-rating {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.star-item {
  font-size: 56rpx;
  color: #d1d5db;
  transition: all 0.2s;
}

.star-item.star-active {
  color: #f5a623;
}

/* 评分标签 */
.rating-label {
  font-size: 24rpx;
  color: #f5a623;
  font-weight: 600;
  margin-left: 12rpx;
}

/* 图片上传网格 */
.image-upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.uploaded-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-delete {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(245, 87, 108, 0.4);
}

.image-upload-btn {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fafbfc 0%, #f8f9fc 100%);
  transition: all 0.3s;
}

.image-upload-btn:active {
  border-color: #667eea;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
}

.upload-icon {
  font-size: 56rpx;
  color: #adb5bd;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #adb5bd;
  font-weight: 500;
}

/* 底部按钮 */
.footer-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  transition: all 0.3s;
}

.cancel-btn {
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  color: #6c757d;
  border: 2rpx solid #e8ecf1;
}

.submit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.footer-btn:active {
  transform: scale(0.96);
}

.cancel-btn:active {
  background: linear-gradient(135deg, #eef1f6 0%, #e8ecf1 100%);
}

/* 表单提示 */
.form-hint {
  font-size: 22rpx;
  color: #adb5bd;
  display: block;
  margin-top: 10rpx;
  font-weight: 400;
  line-height: 32rpx;
}

/* ===== 转让相关样式 ===== */

/* 仓库预览 */
.transfer-repo-preview {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fafbfc 0%, #f0f2f8 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
}

.transfer-repo-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #e8ecf1;
  flex-shrink: 0;
}

.transfer-repo-info {
  flex: 1;
  margin-left: 20rpx;
}

.transfer-repo-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.transfer-repo-detail {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 转让说明 */
.transfer-info-tips {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.06) 0%, rgba(118, 75, 162, 0.06) 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.12);
}

.transfer-tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.transfer-tip-item:last-child {
  margin-bottom: 0;
}

.transfer-tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.transfer-tip-text {
  font-size: 24rpx;
  color: #6c757d;
  line-height: 36rpx;
}

/* 转让链接区域 */
.transfer-link-section {
  margin-top: 16rpx;
  margin-bottom: 40rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #f0f2f8;
}

.transfer-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.transfer-link-display {
  display: flex;
  align-items: center;
  background: #fafbfc;
  border: 2rpx solid #e8ecf1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.transfer-link-text {
  flex: 1;
  font-size: 24rpx;
  color: #667eea;
  word-break: break-all;
  margin-right: 16rpx;
}

.transfer-copy-btn {
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.transfer-qrcode {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.qrcode-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 12rpx;
}

.qrcode-hint {
  font-size: 22rpx;
  color: #adb5bd;
}

/* 转让设置 */
.transfer-settings {
  margin-bottom: 40rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #f0f2f8;
}

.transfer-setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f8;
}

.transfer-setting-item:last-child {
  border-bottom: none;
}

.setting-content {
  flex: 1;
}

.setting-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 4rpx;
}

.setting-desc {
  display: block;
  font-size: 22rpx;
  color: #adb5bd;
}

/* 开关 */
.switch-wrapper {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #e8ecf1;
  position: relative;
  transition: background 0.3s;
  flex-shrink: 0;
}

.switch-wrapper.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.switch-wrapper.active .switch-dot {
  transform: translateX(40rpx);
}
