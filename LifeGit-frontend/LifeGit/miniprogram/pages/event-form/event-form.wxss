/* ============ 表单卡片 ============ */
/* 白底 + 极淡 border + 12px 圆角，无阴影 */
.form-container {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 52rpx;
  border: 1rpx solid #ECECEC;
  box-sizing: border-box;
}

/* 字段间距 24px */
.form-group {
  margin-bottom: 48rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

/* 字段标题 16px/600 */
.form-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: -0.3rpx;
}

.form-label.required::before {
  content: '* ';
  color: #777777;
  font-weight: 400;
}

/* ============ 输入框 ============ */
/* 正文 15px/400，统一 44px 高、8px 圆角 */
.form-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background-color: #FFFFFF;
  box-sizing: border-box;
  color: #1A1A1A;
  transition: border-color 0.2s ease;
}

.form-input:focus {
  border-color: #1A1A1A;
}

/* placeholder 浅灰 */
.ph {
  color: #AAAAAA;
}

/* ============ 选择器 ============ */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 0 24rpx;
  background-color: #FFFFFF;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.form-picker:active {
  background-color: #F7F7F7;
}

.picker-value {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 400;
}

.picker-value.placeholder {
  color: #AAAAAA;
}

.picker-arrow {
  font-size: 40rpx;
  color: #B5B5B5;
  font-weight: 300;
  margin-left: 16rpx;
  line-height: 1;
}

/* ============ 价格输入 ============ */
/* 金额 17px/600，比正文略突出；¥ 15px/600 深灰 */
.price-input-wrapper {
  display: flex;
  align-items: center;
  height: 88rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 0 24rpx;
  background-color: #FFFFFF;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.price-input-wrapper:focus-within {
  border-color: #1A1A1A;
}

.currency-symbol {
  font-size: 30rpx;
  color: #1A1A1A;
  margin-right: 12rpx;
  font-weight: 600;
}

.price-input {
  flex: 1;
  height: 100%;
  font-size: 34rpx;
  border: none;
  background: transparent;
  font-weight: 600;
  color: #1A1A1A;
}

/* ============ 文本域 ============ */
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  background-color: #FFFFFF;
  box-sizing: border-box;
  line-height: 48rpx;
  color: #1A1A1A;
  transition: border-color 0.2s ease;
}

.form-textarea:focus {
  border-color: #1A1A1A;
}

/* 辅助文字 13px/400 */
.char-count {
  font-size: 26rpx;
  color: #999999;
  text-align: right;
  display: block;
  margin-top: 12rpx;
  font-weight: 400;
}

/* ============ 单选按钮组 ============ */
.radio-group {
  display: flex;
  gap: 16rpx;
}

.radio-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  background-color: #F7F7F7;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.radio-item.active {
  border-color: #1A1A1A;
  background-color: #FFFFFF;
}

.radio-icon {
  font-size: 30rpx;
  color: #999999;
  margin-right: 8rpx;
}

.radio-item.active .radio-icon {
  color: #1A1A1A;
}

.radio-label {
  font-size: 30rpx;
  color: #777777;
  font-weight: 400;
}

.radio-item.active .radio-label {
  color: #1A1A1A;
  font-weight: 600;
}

/* ============ 星级评分 ============ */
.star-rating {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.star-item {
  font-size: 56rpx;
  color: #E5E5E5;
  line-height: 1;
  transition: color 0.15s ease;
}

.star-item.star-active {
  color: #1A1A1A;
}

.rating-label {
  font-size: 26rpx;
  color: #777777;
  font-weight: 400;
  margin-left: 16rpx;
}

/* ============ 图片上传 ============ */
.image-upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(26, 26, 26, 0.85);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  text-align: center;
}

.image-upload-btn {
  width: 176rpx;
  height: 176rpx;
  border: 2rpx dashed #D9D9DE;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.image-upload-btn:active {
  border-color: #999999;
  background-color: #F7F7F7;
}

.upload-icon {
  font-size: 48rpx;
  color: #999999;
  margin-bottom: 8rpx;
  font-weight: 300;
  line-height: 1;
}

.upload-text {
  font-size: 26rpx;
  color: #999999;
  font-weight: 400;
}

/* ============ 底部按钮 ============ */
/* 取消：白底灰边深灰字；保存：黑底白字；统一 44px 高 / 8px 圆角 */
.footer-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E5E5E5;
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.cancel-btn {
  background: #FFFFFF;
  color: #1A1A1A;
  border: 1rpx solid #E5E5E5;
  box-sizing: border-box;
}

.cancel-btn:active {
  background: #F7F7F7;
}

.submit-btn {
  background: #1A1A1A;
  color: #FFFFFF;
}

.submit-btn:active {
  background: #333333;
}

/* ============ 表单提示 ============ */
.form-hint {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-top: 12rpx;
  font-weight: 400;
  line-height: 38rpx;
}

/* ============ 转让相关 ============ */

/* 仓库预览 */
.transfer-repo-preview {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #E5E5E5;
}

.transfer-repo-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #E5E5E5;
  flex-shrink: 0;
}

.transfer-repo-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.transfer-repo-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.transfer-repo-detail {
  display: block;
  font-size: 26rpx;
  color: #777777;
}

/* 转让说明 */
.transfer-info-tips {
  background: #F7F7F7;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 48rpx;
  border: 1rpx solid #E5E5E5;
}

.transfer-tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.transfer-tip-item:last-child {
  margin-bottom: 0;
}

.transfer-tip-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #999999;
  flex-shrink: 0;
  margin-top: 16rpx;
  margin-right: 16rpx;
}

.transfer-tip-text {
  font-size: 26rpx;
  color: #777777;
  line-height: 40rpx;
}

/* 转让链接区域 */
.transfer-link-section {
  margin-top: 16rpx;
  margin-bottom: 48rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #F0F0F0;
}

.transfer-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.transfer-link-display {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.transfer-link-text {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
  word-break: break-all;
  margin-right: 16rpx;
}

.transfer-copy-btn {
  font-size: 26rpx;
  color: #FFFFFF;
  background: #1A1A1A;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.transfer-qrcode {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.qrcode-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 12rpx;
}

.qrcode-hint {
  font-size: 26rpx;
  color: #999999;
}

/* 转让设置 */
.transfer-settings {
  margin-bottom: 48rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid #F0F0F0;
}

.transfer-setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.transfer-setting-item:last-child {
  border-bottom: none;
}

.setting-content {
  flex: 1;
}

.setting-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.setting-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

/* 开关 */
.switch-wrapper {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #E5E5E5;
  position: relative;
  transition: background 0.2s ease;
  flex-shrink: 0;
}

.switch-wrapper.active {
  background: #1A1A1A;
}

.switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFFFF;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.2s ease;
}

.switch-wrapper.active .switch-dot {
  transform: translateX(40rpx);
}
