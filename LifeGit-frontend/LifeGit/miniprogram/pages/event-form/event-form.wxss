/**pages/event-form/event-form.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言 */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  background: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1A1A1A;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 32rpx 200rpx;
}

/* ============ 事件头部 ============ */
/* 页面标题 24px/600，副标题 14px/400 灰，形成第一层级 */
.event-header {
  display: flex;
  align-items: center;
  padding: 56rpx 8rpx 48rpx;
}

/* 线性图标：白底浅灰边的小方块，内部为 40rpx 线性 SVG */
.event-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 40rpx 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.header-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.event-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.25;
  letter-spacing: -1rpx;
}

.event-subtitle {
  font-size: 28rpx;
  color: #777777;
  font-weight: 400;
  line-height: 1.45;
  margin-top: 8rpx;
}

/* ---- 各事件类型的线性图标（黑灰描边） ---- */
