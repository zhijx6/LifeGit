/* repo-detail.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f5f5f5 0%, #e8e8e8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 0 40rpx;
}

/* 顶部Banner */
.banner-wrapper {
  position: relative;
  width: 100%;
  margin-bottom: 10rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: auto;
  display: block;
}

/* 仓库基本信息 */
.repo-info {
  display: flex;
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  position: relative;
  overflow: hidden;
}

.repo-info::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #2c2c2c 0%, #1a1a1a 50%, #4d4d4d 100%);
}

.repo-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  margin-right: 28rpx;
  object-fit: cover;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.repo-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.repo-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.repo-brand {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 6rpx;
  font-weight: 500;
}

.repo-model {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 6rpx;
  font-weight: 500;
}

.repo-spec {
  font-size: 24rpx;
  color: #999999;
}

/* 事件时间线 */
.events-section {
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.5rpx;
}

.add-event-btn {
  font-size: 26rpx;
  color: #333333;
  padding: 10rpx 24rpx;
  border: 2rpx solid #333333;
  border-radius: 24rpx;
  transition: all 0.3s;
  font-weight: 600;
  background: transparent;
}

.add-event-btn:active {
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  color: white;
  border-color: transparent;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.timeline {
  position: relative;
  padding-left: 50rpx;
}

.timeline-item {
  position: relative;
  margin-bottom: 40rpx;
  display: flex;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -50rpx;
  top: 10rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  z-index: 2;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  border: 3rpx solid #ffffff;
}

.timeline-line {
  position: absolute;
  left: -38rpx;
  top: 34rpx;
  width: 2rpx;
  height: calc(100% + 16rpx);
  background: linear-gradient(180deg, #e0e0e0 0%, #cccccc 100%);
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-content {
  flex: 1;
  background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-left: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.timeline-content:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.event-time {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.event-type {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: -0.3rpx;
}

.event-description {
  font-size: 24rpx;
  color: #666666;
  line-height: 38rpx;
}

.empty-events {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 26rpx;
}

.empty-events::before {
  content: '📋';
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

/* Issue入口 */
.issue-entry-section {
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.issue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.issue-count {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.header-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.view-all-btn {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
}

.ask-btn {
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.ask-btn:active {
  transform: scale(0.95);
}

.hot-issues {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.issue-preview {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  transition: all 0.3s;
}

.issue-preview:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.issue-status-wrapper {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.status-dot.open {
  background: linear-gradient(135deg, #333333 0%, #1a1a1a 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.status-dot.answered {
  background: linear-gradient(135deg, #666666 0%, #4d4d4d 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.status-dot.closed {
  background: linear-gradient(135deg, #999999 0%, #808080 100%);
}

.issue-preview-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.issue-preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.issue-preview-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.answer-count {
  font-size: 22rpx;
  color: #333333;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.06) 0%, rgba(0, 0, 0, 0.04) 100%);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.issue-time {
  font-size: 22rpx;
  color: #999999;
}

.issue-preview-badge {
  flex-shrink: 0;
}

.badge-text {
  font-size: 20rpx;
  color: #333333;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.05) 100%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 700;
  border: 1rpx solid rgba(0, 0, 0, 0.15);
}

.empty-issues {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999999;
}

/* Fork/转让入口 */
.fork-entry-section {
  background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.fork-header {
  margin-bottom: 24rpx;
}

.fork-desc {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.fork-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fork-option-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.fork-option-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border-color: rgba(0, 0, 0, 0.2);
}

.fork-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #666666 0%, #4d4d4d 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.fork-icon {
  font-size: 32rpx;
}

.fork-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.fork-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.fork-subtitle {
  font-size: 24rpx;
  color: #666666;
}

.fork-arrow {
  font-size: 40rpx;
  color: #cccccc;
  font-weight: 200;
  flex-shrink: 0;
}

.fork-option-card:active .fork-arrow {
  transform: translateX(6rpx);
  color: #666666;
}

/* Fork关系图预览 */
.fork-graph-preview {
  margin-top: 24rpx;
}

.graph-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.graph-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.graph-count {
  font-size: 22rpx;
  color: #666666;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.06) 0%, rgba(0, 0, 0, 0.04) 100%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.graph-preview {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.03) 0%, rgba(0, 0, 0, 0.02) 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.graph-preview:active {
  background: linear-gradient(135deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.03) 100%);
}

.graph-nodes {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.graph-node {
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.graph-node.current {
  background: linear-gradient(135deg, #666666 0%, #4d4d4d 100%);
  color: #ffffff;
}

.node-text {
  font-size: 22rpx;
}

.graph-branches {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-left: 32rpx;
}

.branch-item {
  display: flex;
  align-items: center;
}

.branch-text {
  font-size: 22rpx;
  color: #6c757d;
  font-weight: 500;
}

.view-full-graph {
  font-size: 22rpx;
  color: #666666;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 已转让状态 */
.transferred-section {
  background: linear-gradient(135deg, #666666 0%, #4d4d4d 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.transferred-banner {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.transferred-icon {
  width: 48rpx;
  height: 48rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666666;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.transferred-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.transferred-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.transferred-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.transferred-info {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  min-width: 120rpx;
}

.info-value {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}

.delete-repo-btn {
  margin-top: 16rpx;
  text-align: center;
}
.delete-text {
  font-size: 24rpx;
  color: #ff4d4f;
  font-weight: 500;
}

.event-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.event-delete {
  font-size: 28rpx;
  color: #ff4d4f;
  padding: 8rpx 16rpx;
  opacity: 0.6;
}
.event-delete:active {
  opacity: 1;
}

.mention-btn {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border: 2rpx solid #333;
  border-radius: 24rpx;
}
.mention-btn:active {
  background: #1a1a1a;
  color: #fff;
}