/**pages/transfer-initiate/transfer-initiate.wxss**/
page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #f0f2f8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 30rpx 40rpx;
}

/* 头部说明 */
.header-section {
  text-align: center;
  padding: 50rpx 0;
}

.icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(246, 211, 101, 0.3);
}

.header-icon {
  font-size: 48rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #2c3e50;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #8e9aaf;
  font-weight: 500;
}

/* 仓库信息预览 */
.repo-preview {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.repo-preview-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.repo-preview-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.repo-preview-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
}

.repo-preview-details {
  font-size: 24rpx;
  color: #6c757d;
}

.event-count-badge {
  display: inline-block;
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.1) 0%, rgba(253, 160, 133, 0.1) 100%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 4rpx;
}

.event-count-text {
  font-size: 20rpx;
  color: #f6d365;
  font-weight: 600;
}

/* 转让说明 */
.info-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.info-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

.info-desc {
  font-size: 24rpx;
  color: #8e9aaf;
  line-height: 36rpx;
}

/* 转让链接区域 */
.link-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 24rpx;
  display: block;
}

/* 生成中状态 */
.generating-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(246, 211, 101, 0.2);
  border-top: 4rpx solid #f6d365;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.generating-text {
  font-size: 26rpx;
  color: #8e9aaf;
  font-weight: 500;
}

/* 链接展示 */
.link-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.link-display {
  position: relative;
}

.link-text {
  font-size: 24rpx;
  color: #2c3e50;
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  display: block;
  word-break: break-all;
  line-height: 40rpx;
  font-family: monospace;
}

.link-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.copy-btn,
.share-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.copy-btn {
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  color: #6c757d;
  border: 2rpx solid #e8ecf1;
}

.share-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
}

.copy-btn:active,
.share-btn:active {
  transform: scale(0.98);
}

/* 二维码区域 */
.qrcode-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  border-radius: 20rpx;
}

.qrcode-wrapper {
  width: 200rpx;
  height: 200rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.qrcode-image {
  width: 100%;
  height: 100%;
}

.qrcode-hint {
  font-size: 24rpx;
  color: #8e9aaf;
  font-weight: 500;
}

/* 生成按钮 */
.generate-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  color: white;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(246, 211, 101, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.generate-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(246, 211, 101, 0.3);
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  color: #ffffff;
}

/* 转让设置 */
.settings-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.setting-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.setting-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.setting-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
}

.setting-desc {
  font-size: 22rpx;
  color: #adb5bd;
}

.switch-wrapper {
  width: 80rpx;
  height: 44rpx;
  background: #e8ecf1;
  border-radius: 22rpx;
  position: relative;
  transition: all 0.3s;
  flex-shrink: 0;
}

.switch-wrapper.active {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

.switch-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s;
}

.switch-wrapper.active .switch-dot {
  left: 40rpx;
}

.message-input {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  background-color: #fafbfc;
  box-sizing: border-box;
  transition: all 0.3s;
  line-height: 38rpx;
  color: #2c3e50;
}

.message-input:focus {
  border-color: #f6d365;
  background-color: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(246, 211, 101, 0.1);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.cancel-btn {
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  color: #6c757d;
  border: 2rpx solid #e8ecf1;
}

.confirm-btn {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(246, 211, 101, 0.4);
}

.action-btn:active {
  transform: scale(0.96);
}

.confirm-btn[disabled] {
  opacity: 0.4;
  background: linear-gradient(135deg, #e8ecf1 0%, #d1d5db 100%);
  box-shadow: none;
}
