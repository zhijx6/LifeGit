/**pages/transfer-initiate/transfer-initiate.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 event-form / add-event 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--text-primary);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 32rpx 200rpx;
}

/* ============ 头部说明 ============ */
/* 页面标题 24px/600，副标题 14px/400 灰 */
.header-section {
  padding: 56rpx 8rpx 48rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.header-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 400;
  display: block;
  margin-top: 8rpx;
  line-height: 1.45;
}

/* ============ 仓库信息预览 ============ */
/* 白卡 + 1px 极浅边框 + 12px 圆角，无阴影 */
.repo-preview {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.repo-preview-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  margin-right: 24rpx;
  flex-shrink: 0;
  background: var(--divider);
}

.repo-preview-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.repo-preview-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.repo-preview-details {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.event-count-badge {
  display: inline-block;
  align-self: flex-start;
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  margin-top: 4rpx;
}

.event-count-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

/* ============ 转让说明 ============ */
/* 单张白卡分组 + 发丝分割线 */
.info-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-light);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.info-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--divider);
}

.info-item:last-child {
  border-bottom: none;
}

.info-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  flex-shrink: 0;
  margin-top: 16rpx;
  margin-right: 20rpx;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.info-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
  font-weight: 400;
}

/* ============ 转让链接 ============ */
.link-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: -0.3rpx;
}

/* 生成中状态：黑白细线 spinner */
.generating-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--text-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.generating-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* 链接展示：浅灰底 + 发丝边框 + 6px 圆角 */
.link-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.link-text {
  font-size: 26rpx;
  color: var(--text-primary);
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  display: block;
  word-break: break-all;
  line-height: 40rpx;
  font-weight: 400;
}

.link-actions {
  display: flex;
  gap: 16rpx;
}

/* 「复制」小按钮：黑底白字 */
.copy-btn,
.share-btn {
  font-size: 26rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-sm);
  line-height: 1.4;
}

.copy-btn {
  background: var(--button-primary);
  color: #FFFFFF;
  transition: background-color 0.2s ease;
}

.copy-btn:active {
  background: var(--button-primary-pressed);
}

.share-btn {
  background: var(--button-secondary);
  color: var(--button-secondary-text);
  border: 1rpx solid var(--border);
  box-sizing: border-box;
  transition: background-color 0.2s ease;
}

.share-btn:active {
  background: var(--surface-muted);
}

/* 二维码：白底居中，下方提示 */
.qrcode-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
}

.qrcode-wrapper {
  width: 232rpx;
  height: 232rpx;
  background: var(--surface);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-sm);
  padding: 16rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.qrcode-image {
  width: 100%;
  height: 100%;
}

.qrcode-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* 生成按钮：黑底白字 44px 高 / 10px 圆角 */
.generate-btn {
  width: 100%;
  height: 88rpx;
  background: var(--button-primary);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  font-weight: 500;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease;
}

.generate-btn:active {
  background: var(--button-primary-pressed);
}

.btn-text {
  color: #FFFFFF;
}

/* ============ 转让设置 ============ */
.settings-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.setting-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.setting-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.setting-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* 开关：灰底 ↔ 黑底 */
.switch-wrapper {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--border);
  position: relative;
  transition: background-color 0.2s ease;
  flex-shrink: 0;
}

.switch-wrapper.active {
  background: var(--button-primary);
}

.switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface);
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.2s ease;
}

.switch-wrapper.active .switch-dot {
  transform: translateX(40rpx);
}

/* 附言输入 */
.message-input {
  width: 100%;
  min-height: 200rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-body);
  background-color: var(--surface);
  box-sizing: border-box;
  line-height: 48rpx;
  color: var(--text-primary);
  margin-top: 24rpx;
  transition: border-color 0.2s ease;
}

.message-input:focus {
  border-color: var(--text-primary);
}

.char-count {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: right;
  display: block;
  margin-top: 12rpx;
  font-weight: 400;
}

/* ============ 底部操作条 ============ */
/* 白底 + 上边框，返回次操作 / 完成转让主操作 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.cancel-btn {
  background: var(--button-secondary);
  color: var(--button-secondary-text);
  border: 1rpx solid var(--border);
  box-sizing: border-box;
}

.cancel-btn:active {
  background: var(--surface-muted);
}

.confirm-btn {
  background: var(--button-primary);
  color: #FFFFFF;
}

.confirm-btn:active {
  background: var(--button-primary-pressed);
}

.confirm-btn[disabled] {
  background: #ECECEC;
  color: var(--placeholder);
}
