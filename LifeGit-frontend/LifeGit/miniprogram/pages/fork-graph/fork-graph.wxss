/**pages/fork-graph/fork-graph.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 repo-detail / event-form 同一套体系） */
/* 流转图：左侧灰色细线时间轴 + 节点卡片，当前节点黑底白字，其余浅灰底灰边框 */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--text-primary);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 32rpx 64rpx;
}

/* ============ 头部说明 ============ */
/* 页面标题 24px/600，副标题 14px/400 灰 */
.header-section {
  padding: 56rpx 8rpx 48rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.header-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 400;
  display: block;
  margin-top: 8rpx;
  line-height: 1.45;
}

/* ============ 当前物品 ============ */
/* 白卡 + 1px 极浅边框 + 12px 圆角，无阴影 */
.current-repo-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.3rpx;
}

/* 「正在查看」小徽标：浅灰底 + 发丝边框 */
.current-badge {
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
}

.badge-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

/* 当前仓库节点：黑底白字 */
.repo-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--button-primary);
  background: var(--button-primary);
  box-sizing: border-box;
}

.repo-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-sm);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.repo-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.repo-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.repo-details {
  font-size: 26rpx;
  color: var(--text-light);
  font-weight: 400;
}

.repo-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 4rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-light);
  font-weight: 400;
}

/* ============ 流转历史（时间轴） ============ */
.tree-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* 左侧灰色细线：贯穿各层级 */
.tree-container {
  display: flex;
  flex-direction: column;
  margin-top: 32rpx;
}

.tree-level {
  position: relative;
  padding-left: 48rpx;
  padding-bottom: 40rpx;
}

.tree-level:last-child {
  padding-bottom: 0;
}

.tree-level::before {
  content: '';
  position: absolute;
  left: 19rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: var(--border);
}

/* 首层线从根节点圆点处开始 */
.tree-level:first-child::before {
  top: 72rpx;
}

.level-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 40rpx;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-tertiary);
}

.label-date,
.label-count {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* 节点卡片：浅灰底 + 灰边框；当前节点黑底白字 */
.nodes-wrapper {
  display: flex;
  flex-direction: column;
}

.tree-node {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  box-sizing: border-box;
}

.intermediate-node {
  margin-bottom: 16rpx;
}

.intermediate-node:last-child {
  margin-bottom: 0;
}

.current-node {
  background: var(--button-primary);
  border-color: var(--button-primary);
}

/* 时间轴圆点：当前节点实心黑，其余空心灰 */
.tree-node::before {
  content: '';
  position: absolute;
  left: -34rpx;
  top: 24rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 2rpx solid var(--text-light);
  box-sizing: border-box;
  z-index: 2;
}

.current-node::before {
  background: var(--button-primary);
  border-color: var(--button-primary);
}

/* 原居中连线视图由左侧细线取代 */
.node-connector,
.node-connector-top {
  display: none;
}

.node-avatar-wrapper {
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.node-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: block;
}

.node-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.node-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.node-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.node-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* 当前节点文字反白 */
.current-node .node-name {
  color: #FFFFFF;
}

.current-node .node-desc,
.current-node .node-time {
  color: var(--text-light);
}

.event-summary {
  margin-top: 8rpx;
}

.event-count {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.current-node .event-count {
  color: var(--text-light);
}

/* ============ 统计信息 ============ */
.stats-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: -0.5rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ============ 说明提示 ============ */
/* 单张白卡分组 + 发丝分割线 */
.tips-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-light);
  overflow: hidden;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--divider);
}

.tip-item:last-child {
  border-bottom: none;
}

.tip-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  flex-shrink: 0;
  margin-top: 14rpx;
  margin-right: 20rpx;
}

.tip-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
  font-weight: 400;
}
