/**pages/fork-graph/fork-graph.wxss**/
page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #f0f2f8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 30rpx 40rpx;
}

/* 头部说明 */
.header-section {
  text-align: center;
  padding: 50rpx 0;
}

.icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(246, 211, 101, 0.3);
}

.header-icon {
  font-size: 48rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #2c3e50;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #8e9aaf;
  font-weight: 500;
}

/* 当前仓库信息 */
.current-repo-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

.current-badge {
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.15) 0%, rgba(253, 160, 133, 0.15) 100%);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #f6d365;
  font-weight: 600;
}

.repo-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.repo-card.current {
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.08) 0%, rgba(253, 160, 133, 0.08) 100%);
  border-color: #f6d365;
}

.repo-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.repo-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.repo-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
}

.repo-details {
  font-size: 24rpx;
  color: #6c757d;
}

.repo-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 4rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #adb5bd;
}

/* 流转树状图 */
.tree-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.section-subtitle {
  font-size: 24rpx;
  color: #8e9aaf;
  font-weight: 500;
}

.tree-container {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.tree-level {
  position: relative;
}

.level-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #8e9aaf;
}

.label-date,
.label-count {
  font-size: 22rpx;
  color: #adb5bd;
}

/* 树节点 */
.tree-node {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-radius: 20rpx;
  position: relative;
  margin-left: 40rpx;
}

.root-node {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border: 2rpx solid rgba(102, 126, 234, 0.2);
}

.intermediate-node {
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  margin-bottom: 16rpx;
}

.current-node {
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.08) 0%, rgba(253, 160, 133, 0.08) 100%);
  border: 2rpx solid #f6d365;
  box-shadow: 0 8rpx 24rpx rgba(246, 211, 101, 0.2);
}

.node-connector-top {
  position: absolute;
  top: -32rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #e8ecf1 0%, #f6d365 100%);
}

.node-connector {
  position: absolute;
  bottom: -32rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #f6d365 0%, #e8ecf1 100%);
}

.root-node .node-connector {
  background: linear-gradient(180deg, rgba(102, 126, 234, 0.3) 0%, #e8ecf1 100%);
}

.node-avatar-wrapper {
  position: relative;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.node-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.node-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
}

.root-badge {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.transfer-badge {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

.current-badge {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
}

.badge-icon {
  font-size: 16rpx;
}

.node-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.node-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
}

.node-desc {
  font-size: 24rpx;
  color: #6c757d;
}

.node-time {
  font-size: 22rpx;
  color: #adb5bd;
}

.event-summary {
  margin-top: 8rpx;
}

.event-count {
  font-size: 22rpx;
  color: #f6d365;
  font-weight: 600;
}

/* 统计信息 */
.stats-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #f6d365;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #8e9aaf;
  font-weight: 500;
}

/* 操作提示 */
.tips-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #6c757d;
  line-height: 36rpx;
}
