/**pages/transfer-receive/transfer-receive.wxss**/
page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #f0f2f8 100%);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 30rpx 40rpx;
}

/* 头部欢迎 */
.welcome-section {
  text-align: center;
  padding: 40rpx 0;
}

.welcome-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(246, 211, 101, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.welcome-icon {
  font-size: 48rpx;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #2c3e50;
  display: block;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #8e9aaf;
  font-weight: 500;
}

/* 物品信息展示 */
.item-showcase {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.showcase-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.showcase-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

.original-owner-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.owner-label {
  font-size: 24rpx;
  color: #adb5bd;
}

.owner-name {
  font-size: 26rpx;
  color: #f6d365;
  font-weight: 600;
}

.item-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  margin-bottom: 24rpx;
}

.item-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #2c3e50;
}

.item-brand {
  font-size: 24rpx;
  color: #6c757d;
}

.item-model {
  font-size: 24rpx;
  color: #6c757d;
}

.item-spec {
  font-size: 22rpx;
  color: #adb5bd;
}

/* 继承记录预览 */
.inherit-preview {
  margin-top: 20rpx;
}

.inherit-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #f6d365;
  margin-bottom: 16rpx;
  display: block;
}

.inherit-scroll {
  max-height: 300rpx;
}

.inherit-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.inherit-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.inherit-icon-wrapper {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.inherit-icon-wrapper.purchase {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
}

.inherit-icon-wrapper.maintenance {
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.1) 0%, rgba(245, 87, 108, 0.1) 100%);
}

.inherit-icon-wrapper.upgrade {
  background: linear-gradient(135deg, rgba(79, 172, 254, 0.1) 0%, rgba(0, 242, 254, 0.1) 100%);
}

.inherit-icon-wrapper.experience {
  background: linear-gradient(135deg, rgba(67, 233, 123, 0.1) 0%, rgba(56, 249, 215, 0.1) 100%);
}

.inherit-icon {
  font-size: 24rpx;
}

.inherit-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.inherit-type {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 600;
}

.inherit-desc {
  font-size: 24rpx;
  color: #6c757d;
}

.inherit-time {
  font-size: 20rpx;
  color: #adb5bd;
}

/* 附言区域 */
.message-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.message-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.message-content {
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  padding: 20rpx;
  border-radius: 16rpx;
}

.message-text {
  font-size: 26rpx;
  color: #6c757d;
  line-height: 40rpx;
}

/* 接收表单 */
.form-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 28rpx;
  display: block;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
  display: block;
  margin-bottom: 14rpx;
}

.form-label.required::before {
  content: '*';
  color: #f5576c;
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background-color: #fafbfc;
  box-sizing: border-box;
  transition: all 0.3s;
  color: #2c3e50;
}

.form-input:focus {
  border-color: #f6d365;
  background-color: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(246, 211, 101, 0.1);
}

.confirm-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.confirm-item {
  font-size: 24rpx;
  color: #6c757d;
  line-height: 36rpx;
  padding-left: 20rpx;
  position: relative;
}

.confirm-item::before {
  content: '•';
  position: absolute;
  left: 0;
  color: #f6d365;
  font-weight: 700;
}

.options-section {
  margin-top: 24rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  border-radius: 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.option-item:active {
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.08) 0%, rgba(253, 160, 133, 0.08) 100%);
}

.checkbox-wrapper {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  transition: all 0.3s;
}

.checkbox-wrapper.checked {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  border-color: transparent;
}

.checkbox-icon {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.option-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
}

.option-desc {
  font-size: 22rpx;
  color: #adb5bd;
}

/* Fork链路预览 */
.fork-preview-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.preview-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.fork-chain {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

.chain-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9fc 0%, #f0f2f8 100%);
  border-radius: 16rpx;
  min-width: 160rpx;
}

.chain-node.original {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
}

.chain-node.current {
  background: linear-gradient(135deg, rgba(246, 211, 101, 0.08) 0%, rgba(253, 160, 133, 0.08) 100%);
  border: 2rpx solid #f6d365;
}

.node-label {
  font-size: 20rpx;
  color: #8e9aaf;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.node-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3e50;
}

.chain-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  font-weight: 200;
  margin: 0 20rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  transition: all 0.3s;
}

.decline-btn {
  background: linear-gradient(135deg, #f8f9fc 0%, #eef1f6 100%);
  color: #6c757d;
  border: 2rpx solid #e8ecf1;
}

.accept-btn {
  background: linear-gradient(135deg, #e8ecf1 0%, #d1d5db 100%);
  color: #adb5bd;
  border: none;
}

.accept-btn.active {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(246, 211, 101, 0.3);
}

.action-btn:active {
  transform: scale(0.96);
}

.accept-btn[disabled] {
  opacity: 0.5;
}

.btn-text {
  color: inherit;
}
