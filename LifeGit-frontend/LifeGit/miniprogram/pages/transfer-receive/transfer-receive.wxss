/**pages/transfer-receive/transfer-receive.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 event-form / add-event 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--text-primary);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 32rpx 200rpx;
}

/* ============ 头部欢迎 ============ */
/* 页面标题 24px/600，副标题 14px/400 灰 */
.welcome-section {
  padding: 56rpx 8rpx 48rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.welcome-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 400;
  display: block;
  margin-top: 8rpx;
  line-height: 1.45;
}

/* ============ 物品信息展示 ============ */
/* 白卡 + 1px 极浅边框 + 12px 圆角，无阴影 */
.item-showcase {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.showcase-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.showcase-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.3rpx;
}

.original-owner-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.owner-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

.owner-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 物品行：卡内嵌套块，浅灰底 + 发丝边框 */
.item-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.item-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-sm);
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--divider);
}

.item-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.item-brand,
.item-model {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.item-spec {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ============ 继承记录预览 ============ */
.inherit-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: block;
}

.inherit-scroll {
  max-height: 320rpx;
}

.inherit-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.inherit-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.inherit-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  flex-shrink: 0;
  margin-right: 16rpx;
}

.inherit-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.inherit-type {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.inherit-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.inherit-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ============ 附言 ============ */
.message-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.message-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
  letter-spacing: -0.3rpx;
}

.message-content {
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.message-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
  font-weight: 400;
}

/* ============ 接收表单 ============ */
.form-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 32rpx;
  display: block;
  letter-spacing: -0.3rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: -0.3rpx;
}

.form-label.required::before {
  content: '* ';
  color: var(--text-secondary);
  font-weight: 400;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: var(--font-body);
  background-color: var(--surface);
  box-sizing: border-box;
  color: var(--text-primary);
  transition: border-color 0.2s ease;
}

.form-input:focus {
  border-color: var(--text-primary);
}

/* 确认信息 */
.confirm-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.confirm-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 40rpx;
  font-weight: 400;
}

/* 选项：卡内嵌套块 */
.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.option-item:active {
  background: var(--surface);
  border-color: var(--text-primary);
}

.checkbox-wrapper {
  width: 40rpx;
  height: 40rpx;
  border: 1rpx solid var(--text-light);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.checkbox-wrapper.checked {
  background: var(--button-primary);
  border-color: var(--button-primary);
}

.checkbox-icon {
  font-size: 24rpx;
  color: #FFFFFF;
}

.option-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.option-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.option-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

/* ============ 流转链路预览 ============ */
/* 当前节点黑底白字，其他节点浅灰底灰边框，箭头浅灰 */
.fork-preview-section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: -0.3rpx;
}

.fork-chain {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.chain-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-sm);
  min-width: 176rpx;
  box-sizing: border-box;
}

.chain-node.original {
  background: var(--surface-muted);
  border: 1rpx solid var(--border);
}

.chain-node.current {
  background: var(--button-primary);
  border: 1rpx solid var(--button-primary);
}

.node-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  margin-bottom: 8rpx;
}

.chain-node.current .node-label {
  color: var(--text-light);
}

.node-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.chain-node.current .node-name {
  color: #FFFFFF;
}

.chain-arrow {
  font-size: 40rpx;
  color: var(--text-light);
  font-weight: 300;
  margin: 0 24rpx;
  line-height: 1;
}

/* ============ 底部操作条 ============ */
/* 白底 + 上边框，拒绝次操作 / 接收主操作 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.decline-btn {
  background: var(--button-secondary);
  color: var(--button-secondary-text);
  border: 1rpx solid var(--border);
  box-sizing: border-box;
}

.decline-btn:active {
  background: var(--surface-muted);
}

/* 未填写昵称：浅灰禁用态；填写后：黑底白字 */
.accept-btn {
  background: #ECECEC;
  color: var(--placeholder);
}

.accept-btn.active {
  background: var(--button-primary);
  color: #FFFFFF;
}

.accept-btn.active:active {
  background: var(--button-primary-pressed);
}

.btn-text {
  color: inherit;
}
