<view class="page">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">当前密码</text>
      <input class="form-input" placeholder="请输入当前密码" password value="{{oldPassword}}" bindinput="onOldPasswordInput" />
    </view>

    <view class="form-item">
      <text class="form-label">新密码</text>
      <input class="form-input" placeholder="请输入新密码（至少6位）" password value="{{newPassword}}" bindinput="onNewPasswordInput" />
    </view>

    <view class="form-item">
      <text class="form-label">确认新密码</text>
      <input class="form-input" placeholder="请再次输入新密码" password value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
    </view>
  </view>

  <button class="submit-btn" bindtap="submit" disabled="{{loading}}" loading="{{loading}}">确认修改</button>
</view>
