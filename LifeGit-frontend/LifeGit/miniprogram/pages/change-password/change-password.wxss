.page {
  min-height: 100vh;
  background: #000;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.form-card {
  background: #111;
  border: 2rpx solid #333;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 48rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #333;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #000;
  color: #fff;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #000;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.4;
}
