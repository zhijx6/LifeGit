/**pages/change-password/change-password.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 event-form 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  background: var(--bg, #F7F7F7);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--text-primary, #1A1A1A);
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* ============ 表单卡片 ============ */
/* 白底 + 极浅边框 + 12px 圆角，无阴影；表单卡内边距 24px 20px */
.form-card {
  background: var(--surface, #FFFFFF);
  border: 1rpx solid var(--border-light, #ECECEC);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* 字段组间距 24px */
.form-item {
  margin-bottom: 48rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

/* 字段标题 16px/600 */
.form-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary, #1A1A1A);
  margin-bottom: 24rpx;
  letter-spacing: -0.3rpx;
}

/* ============ 输入框 ============ */
/* 44px 高 / 10px 圆角 / 白底 / 1px 灰边，focus 只变黑边 */
.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border, #E5E5E5);
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 400;
  box-sizing: border-box;
  background: var(--surface, #FFFFFF);
  color: var(--text-primary, #1A1A1A);
  transition: border-color 0.2s ease;
}

.form-input:focus {
  border-color: var(--text-primary, #1A1A1A);
}

/* 占位符浅灰 */
.ph {
  color: var(--placeholder, #AAAAAA);
}

/* ============ 提交按钮 ============ */
/* 主操作：黑底白字 / 44px 高 / 10px 圆角 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--button-primary, #1A1A1A);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 20rpx;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  background: var(--button-primary-pressed, #333333);
}

.submit-btn[disabled] {
  opacity: 0.4;
}
