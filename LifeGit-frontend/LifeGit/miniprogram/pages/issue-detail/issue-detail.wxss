/**pages/issue-detail/issue-detail.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 add-event / event-form 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  background: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #1A1A1A;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 底部预留固定输入条空间 */
.container {
  padding: 0 32rpx 240rpx;
}

/* ============ 问题详情卡片 ============ */
.question-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECECEC;
  padding: 32rpx;
  margin: 24rpx 0 24rpx;
  box-sizing: border-box;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

/* 状态徽章：白底 + 浅灰边框 + 灰阶状态点；已解答带 ✓ */
.status-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  box-sizing: border-box;
}

.status-badge::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #E5E5E5;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.status-badge.open::before {
  background: #1A1A1A;
}

.status-badge.answered::before {
  background: #777777;
}

.status-badge.closed::before {
  background: #E5E5E5;
}

.status-text {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
  line-height: 1.2;
}

.status-badge.answered .status-text::before {
  content: '✓ ';
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-buttons .action-btn {
  font-size: 24rpx;
  color: #777777;
  font-weight: 400;
  padding: 8rpx 0;
  transition: color 0.2s ease;
}

.action-buttons .action-btn:active {
  color: #1A1A1A;
}

/* 删除操作：灰边胶囊，不用红色 */
.delete-action {
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 8rpx 20rpx !important;
}

.delete-action:active {
  background: #F7F7F7;
}

.question-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  display: block;
  line-height: 52rpx;
  letter-spacing: -0.5rpx;
}

.question-author {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F0F0F0;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.author-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.author-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.create-time {
  font-size: 22rpx;
  color: #999999;
}

.question-content {
  font-size: 30rpx;
  color: #1A1A1A;
  line-height: 50rpx;
  margin-bottom: 24rpx;
  display: block;
}

.question-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #777777;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 400;
}

/* ============ 最佳答案 ============ */
.best-answer-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECECEC;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.best-answer-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

/* 黑色小图标 + 白色 ✓ */
.best-answer-icon {
  width: 36rpx;
  height: 36rpx;
  background: #1A1A1A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.best-answer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.cancel-best-btn {
  font-size: 24rpx;
  color: #777777;
  margin-left: auto;
  padding: 8rpx 20rpx;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.cancel-best-btn:active {
  background: #F7F7F7;
  color: #1A1A1A;
}

/* 卡内嵌套块：#F7F7F7 底 + #E5E5E5 边框 + 20rpx 圆角 */
.best-answer-section .answer-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.answer-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar-small {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F0F0F0;
  flex-shrink: 0;
}

/* 已采纳徽章：白底 + 浅灰边框 + 黑字 + ✓ */
.best-badge {
  font-size: 20rpx;
  color: #1A1A1A;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.best-badge::before {
  content: '✓ ';
}

.answer-text {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 46rpx;
}

/* Commit 引用（嵌套块内的白色条目） */
.commit-refs {
  margin-top: 4rpx;
}

.refs-title {
  font-size: 24rpx;
  color: #999999;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.ref-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  box-sizing: border-box;
}

.ref-item:last-child {
  margin-bottom: 0;
}

.ref-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.ref-type {
  font-size: 22rpx;
  color: #777777;
  font-weight: 600;
}

.ref-desc {
  font-size: 24rpx;
  color: #777777;
  line-height: 36rpx;
}

.answer-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.answer-time {
  font-size: 22rpx;
  color: #999999;
}

.answer-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-item {
  font-size: 24rpx;
  color: #777777;
}

/* ============ 回答列表 ============ */
.answers-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: -0.3rpx;
}

.answer-item {
  display: flex;
  background: #FFFFFF;
  border: 1rpx solid #ECECEC;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.answer-item:last-child {
  margin-bottom: 0;
}

.answer-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F0F0F0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.answer-content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.answer-author-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.answer-create-time {
  font-size: 22rpx;
  color: #999999;
}

.answer-content-wrapper .answer-content {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 46rpx;
}

.answer-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 4rpx;
}

/* 点赞：单色字符 ◉ / ○ */
.answer-actions .action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #777777;
  transition: color 0.2s ease;
}

.answer-actions .action-btn:active {
  color: #1A1A1A;
}

.action-icon {
  font-size: 28rpx;
  color: #777777;
  line-height: 1;
}

.answer-actions .action-btn:active .action-icon {
  color: #1A1A1A;
}

.action-count {
  font-weight: 500;
}

/* 设为最佳答案：黑底白字小按钮 */
.set-best-btn {
  padding: 10rpx 24rpx;
  background: #1A1A1A;
  border-radius: 12rpx;
  transition: background-color 0.2s ease;
}

.set-best-btn:active {
  background: #333333;
}

.set-best-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* ============ 空状态 ============ */
.empty-answers {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #777777;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
}

/* ============ 底部回答输入条 ============ */
/* 白底 + 上边框 + 安全区适配 */
.reply-input-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E5E5E5;
  z-index: 100;
}

.input-wrapper {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.input-wrapper:focus-within {
  border-color: #1A1A1A;
}

.reply-input {
  width: 100%;
  min-height: 48rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  line-height: 48rpx;
  border: none;
}

.ph {
  color: #AAAAAA;
}

.input-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.toolbar-btn {
  font-size: 26rpx;
  color: #777777;
  padding: 8rpx 20rpx;
  background: #F7F7F7;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.toolbar-btn:active {
  background: #F0F0F0;
  color: #1A1A1A;
}

.char-count {
  font-size: 22rpx;
  color: #999999;
  font-weight: 400;
}

/* 发送：黑底白字主按钮；禁用浅灰 */
.submit-btn {
  width: 128rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1A1A1A;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  padding: 0;
  margin: 0;
  align-self: flex-end;
  transition: background-color 0.2s ease;
}

.submit-btn:active {
  background: #333333;
}

.submit-btn[disabled] {
  background: #F0F0F0;
  color: #AAAAAA;
}

/* ============ 弹窗 ============ */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.modal-close {
  font-size: 36rpx;
  color: #B5B5B5;
  line-height: 1;
  padding: 8rpx;
  transition: color 0.2s ease;
}

.modal-close:active {
  color: #1A1A1A;
}

.modal-body {
  max-height: 600rpx;
  overflow-y: auto;
  padding: 16rpx 0;
}

.user-list,
.commit-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-item,
.commit-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: transparent;
  border-radius: 12rpx;
  margin: 0 24rpx;
  transition: background-color 0.2s ease;
}

.user-item.active,
.commit-item.active {
  background: #F7F7F7;
}

.user-item:active,
.commit-item:active {
  background: #F7F7F7;
}

.user-avatar-small {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F0F0F0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-name {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.commit-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.commit-type {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.commit-desc {
  font-size: 26rpx;
  color: #777777;
  line-height: 38rpx;
}

.commit-time {
  font-size: 22rpx;
  color: #999999;
}

/* 选中标记：黑色 ✓ */
.check-icon {
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.modal-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease;
}

.confirm-btn:active {
  background: #333333;
}
