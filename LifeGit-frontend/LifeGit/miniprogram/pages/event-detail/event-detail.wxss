/**pages/event-detail/event-detail.wxss**/
/* 黑白灰 · 极简 · 工具类 App 设计语言（与 event-form / add-event / repo-detail 同一套体系） */
/* 间距采用 8px 网格（rpx = 2×px）：8/12/16/20/24/32 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg, #F7F7F7);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--text-primary, #1A1A1A);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 0 32rpx 64rpx;
}

/* ============ 事件头部 ============ */
/* 事件类型名作页面标题 24px/600，时间 14px/400 灰，左对齐（与其他页一致） */
.event-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 56rpx 8rpx 48rpx;
}

.event-type-name {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-primary, #1A1A1A);
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.event-time {
  font-size: 28rpx;
  color: var(--text-secondary, #777777);
  font-weight: 400;
  margin-top: 8rpx;
  line-height: 1.45;
}

/* ============ 字段卡片 ============ */
/* 白卡 + 发丝边框 + 12px 圆角，无阴影；行间发丝分割线（Apple 设置页风格） */
.content-card {
  background: var(--surface, #FFFFFF);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-light, #ECECEC);
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* 字段行：左右排列，标签 13px 灰 / 值 15px 深色 */
.field-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider, #F0F0F0);
}

.field-item:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-tertiary, #999999);
  font-weight: 400;
  flex-shrink: 0;
  margin-right: 24rpx;
  line-height: 44rpx;
}

.field-value {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--text-primary, #1A1A1A);
  font-weight: 400;
  text-align: right;
  word-break: break-all;
  line-height: 44rpx;
}

/* ============ 图片网格 ============ */
/* 88px 方块 / 10px 圆角 / 8px 间距 */
.field-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 0;
}

.detail-image {
  width: 176rpx;
  height: 176rpx;
  border-radius: 20rpx;
  background: var(--divider, #F0F0F0);
}

/* ============ 删除操作 ============ */
/* 次操作按钮：白底灰边，文字弱化为次级灰，按压变灰底 */
.danger-zone {
  margin-top: 8rpx;
}

.delete-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--button-secondary, #FFFFFF);
  color: var(--text-secondary, #777777);
  font-size: 30rpx;
  font-weight: 500;
  border: 1rpx solid var(--border, #E5E5E5);
  border-radius: 20rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.delete-btn::after {
  border: none;
}

.delete-btn:active {
  background: var(--surface-muted, #F7F7F7);
  color: var(--text-primary, #1A1A1A);
}
