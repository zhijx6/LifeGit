/**app.wxss**/
/* LifeGit 全局设计系统：黑白灰 · 极简 · 高级 · 克制 · 工具类 App */
/* 所有页面统一使用本文件定义的 Design Token，不要在页面内自定义颜色体系 */

page {
  /* ===== Design Tokens：颜色 ===== */
  --bg: #F7F7F7;                    /* 页面背景 */
  --surface: #FFFFFF;               /* 卡片 / 表面 */
  --surface-muted: #F7F7F7;         /* 弱表面：卡内嵌套块 / 按压态 */
  --text-primary: #1A1A1A;          /* 主文字 */
  --text-secondary: #777777;        /* 次级文字 */
  --text-tertiary: #999999;         /* 辅助文字 */
  --text-light: #B5B5B5;            /* 浅色文字 / 箭头 */
  --placeholder: #AAAAAA;           /* 占位符 */
  --border: #E5E5E5;                /* 输入框 / 嵌套块边框 */
  --border-light: #ECECEC;          /* 卡片边框（极浅） */
  --divider: #F0F0F0;               /* 分割线 */
  --button-primary: #1A1A1A;        /* 主按钮背景 */
  --button-primary-pressed: #333333;/* 主按钮按压态 */
  --button-secondary: #FFFFFF;      /* 次按钮背景 */
  --button-secondary-text: #1A1A1A; /* 次按钮文字 */

  /* ===== Design Tokens：圆角 ===== */
  --radius-sm: 12rpx;               /* 徽章 / 小标签 6px */
  --radius-md: 20rpx;               /* 输入框 / 按钮 10px */
  --radius-lg: 24rpx;               /* 卡片 12px */

  /* ===== Design Tokens：字号 ===== */
  --font-title: 48rpx;              /* 页面标题 24px / 600 */
  --font-section: 40rpx;            /* 模块标题 20px / 600 */
  --font-label: 32rpx;              /* 字段标题 16px / 500-600 */
  --font-body: 30rpx;               /* 正文 15px / 400 */
  --font-caption: 26rpx;            /* 辅助文字 13px / 400 */

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: 1.6;
}

/* ===== 通用容器 ===== */
.container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 通用卡片：白底 + 1px 极浅边框 + 12px 圆角，无阴影 ===== */
.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-light);
  box-sizing: border-box;
}

/* ===== 通用按钮 ===== */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  font-weight: 500;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.btn:active {
  opacity: 0.9;
}

/* 主操作：黑底白字 */
.btn-primary {
  background: var(--button-primary);
  color: #FFFFFF;
}

.btn-primary:active {
  background: var(--button-primary-pressed);
}

/* 次操作：白底灰边黑字 */
.btn-secondary {
  background: var(--button-secondary);
  color: var(--button-secondary-text);
  border: 1rpx solid var(--border);
  box-sizing: border-box;
}

.btn-secondary:active {
  background: var(--surface-muted);
}

.btn-outline {
  background: transparent;
  border: 1rpx solid var(--text-primary);
  color: var(--text-primary);
  box-sizing: border-box;
}

/* ===== 通用输入框 ===== */
.input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: var(--font-body);
  background-color: var(--surface);
  box-sizing: border-box;
  color: var(--text-primary);
  transition: border-color 0.2s ease;
}

.input:focus {
  border-color: var(--text-primary);
}

/* 占位符 */
.ph {
  color: var(--placeholder);
}

/* ===== 通用文字层级 ===== */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-muted {
  color: var(--text-tertiary);
}

/* 页面标题 24px / 600 */
.text-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -1rpx;
}

/* 模块标题 20px / 600 */
.text-subtitle {
  font-size: var(--font-section);
  font-weight: 600;
  color: var(--text-primary);
}

/* 正文 15px / 400 */
.text-body {
  font-size: var(--font-body);
  color: var(--text-secondary);
}

/* 辅助 13px / 400 */
.text-caption {
  font-size: var(--font-caption);
  color: var(--text-tertiary);
}

/* ===== 通用间距（8px 网格） ===== */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mt-40 { margin-top: 40rpx; }
.mt-60 { margin-top: 60rpx; }

.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mb-40 { margin-bottom: 40rpx; }
.mb-60 { margin-bottom: 60rpx; }

.pt-10 { padding-top: 10rpx; }
.pt-20 { padding-top: 20rpx; }
.pt-30 { padding-top: 30rpx; }
.pt-40 { padding-top: 40rpx; }
.pt-60 { padding-top: 60rpx; }

.pb-10 { padding-bottom: 10rpx; }
.pb-20 { padding-bottom: 20rpx; }
.pb-30 { padding-bottom: 30rpx; }
.pb-40 { padding-bottom: 40rpx; }
.pb-60 { padding-bottom: 60rpx; }

/* ===== 通用布局 ===== */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* ===== 通用圆角 ===== */
.radius-sm { border-radius: var(--radius-sm); }
.radius-md { border-radius: var(--radius-md); }
.radius-lg { border-radius: var(--radius-lg); }
.radius-xl { border-radius: 28rpx; }
.radius-2xl { border-radius: 32rpx; }
.radius-full { border-radius: 9999rpx; }

/* ===== 通用阴影（默认不用；必须用时保持极弱） ===== */
.shadow-xs {
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.03);
}

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.shadow-md {
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.shadow-lg {
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.shadow-xl {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* ===== 动画 ===== */
.fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.scale-in {
  animation: scaleIn 0.2s ease-out;
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.slide-up {
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(100rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
