/**app.wxss**/
/* 全局样式 */
page {
  background: linear-gradient(180deg, #f5f5f5 0%, #e8e8e8 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

/* 通用按钮 */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.3s, height 0.3s;
}

.btn:active::after {
  width: 200rpx;
  height: 200rpx;
}

.btn:active {
  transform: scale(0.96);
}

.btn-primary {
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.btn-secondary {
  background: linear-gradient(135deg, #666666 0%, #4d4d4d 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.btn-outline {
  background: transparent;
  border: 2rpx solid #333333;
  color: #333333;
}

/* 通用输入框 */
.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  background-color: #fafbfc;
  box-sizing: border-box;
  transition: all 0.3s;
}

.input:focus {
  border-color: #333333;
  background-color: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(0, 0, 0, 0.08);
}

/* 通用文本 */
.text-primary {
  color: #1a1a1a;
}

.text-secondary {
  color: #4d4d4d;
}

.text-muted {
  color: #999999;
}

.text-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.5rpx;
}

.text-subtitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2d2d;
}

.text-body {
  font-size: 28rpx;
  color: #4d4d4d;
}

.text-caption {
  font-size: 24rpx;
  color: #999999;
}

/* 渐变背景类 */
.gradient-purple {
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
}

.gradient-pink {
  background: linear-gradient(135deg, #4d4d4d 0%, #333333 100%);
}

.gradient-blue {
  background: linear-gradient(135deg, #666666 0%, #4d4d4d 100%);
}

.gradient-green {
  background: linear-gradient(135deg, #808080 0%, #666666 100%);
}

.gradient-orange {
  background: linear-gradient(135deg, #999999 0%, #808080 100%);
}

.gradient-sunset {
  background: linear-gradient(135deg, #b3b3b3 0%, #999999 100%);
}

/* 毛玻璃效果 */
.glass {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 通用间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mt-40 { margin-top: 40rpx; }
.mt-60 { margin-top: 60rpx; }

.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mb-40 { margin-bottom: 40rpx; }
.mb-60 { margin-bottom: 60rpx; }

.pt-10 { padding-top: 10rpx; }
.pt-20 { padding-top: 20rpx; }
.pt-30 { padding-top: 30rpx; }
.pt-40 { padding-top: 40rpx; }
.pt-60 { padding-top: 60rpx; }

.pb-10 { padding-bottom: 10rpx; }
.pb-20 { padding-bottom: 20rpx; }
.pb-30 { padding-bottom: 30rpx; }
.pb-40 { padding-bottom: 40rpx; }
.pb-60 { padding-bottom: 60rpx; }

/* 通用布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 通用圆角 */
.radius-sm { border-radius: 8rpx; }
.radius-md { border-radius: 12rpx; }
.radius-lg { border-radius: 16rpx; }
.radius-xl { border-radius: 24rpx; }
.radius-2xl { border-radius: 32rpx; }
.radius-full { border-radius: 9999rpx; }

/* 通用阴影 */
.shadow-xs {
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.05);
}

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.shadow-md {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.shadow-xl {
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.16);
}

/* 彩色阴影 */
.shadow-purple {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.shadow-pink {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.shadow-blue {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

/* 动画效果 */
.fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.scale-in {
  animation: scaleIn 0.2s ease-out;
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.slide-up {
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(100rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
